# Generated by Rulesync from .rulesync/permissions.jsonc (permission.bash)
# https://developers.openai.com/codex/rules

# *
prefix_rule(
    pattern = ["*"],
    decision = "prompt",
    justification = "Generated from Rulesync permission.bash: *",
)

# git status
prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Generated from Rulesync permission.bash: git status",
)

# git diff *
prefix_rule(
    pattern = ["git", "diff", "*"],
    decision = "allow",
    justification = "Generated from Rulesync permission.bash: git diff *",
)

# npm publish
prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "Generated from Rulesync permission.bash: npm publish",
)

# sudo *
prefix_rule(
    pattern = ["sudo", "*"],
    decision = "forbidden",
    justification = "Generated from Rulesync permission.bash: sudo *",
)

# rm -rf *
prefix_rule(
    pattern = ["rm", "-rf", "*"],
    decision = "forbidden",
    justification = "Generated from Rulesync permission.bash: rm -rf *",
)
